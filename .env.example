# Copie para .env na raiz. Nunca versionar .env. Modo de produção falha sem configuração.
NODE_ENV=development
APP_MODE=supabase
PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000
# Login dedicado, NOLOGIN roles sc_api/sc_worker concedidos a ele. Não usar postgres em produção.
DATABASE_URL=postgresql://sc_backend:REPLACE@127.0.0.1:54322/postgres
# false apenas no Supabase LOCAL. Remoto: true, certificado verificado.
DATABASE_SSL=false
# Caminho relativo à raiz do projeto para validar a CA no Supabase hospedado.
DATABASE_SSL_CA_PATH=
# Alternativa para serverless: conteúdo PEM completo, com quebras reais ou escapadas como \\n.
DATABASE_SSL_CA=
# Use 2 em serverless para limitar conexões por instância; local pode usar até 10.
DATABASE_POOL_MAX=10
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Somente backend: necessário para retenção de imagem >0 e provisionamento de seed Auth.
SUPABASE_SERVICE_ROLE_KEY=
# Gere dois segredos independentes (32 bytes aleatórios); criptografia exige 64 hex.
PIN_PEPPER=
OUTBOX_ENCRYPTION_KEY=
OCR_SERVICE_URL=http://127.0.0.1:8000
OCR_SERVICE_TOKEN=
# 0 = não armazenar foto (padrão de minimização); 1..30 = Storage privado + limpeza horária.
OCR_IMAGE_RETENTION_DAYS=0
WHATSAPP_PROVIDER=fake
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Versão Graph suportada pelo aplicativo Meta: configurar explicitamente, sem fallback silencioso.
META_GRAPH_VERSION=
META_TEMPLATE_NAME=encomenda_recebida
# Somente seed local. Escolha uma senha forte; scripts não imprimem a senha.
SEED_PASSWORD=
# Provisionamento local usa conexão de migração (postgres). Não é utilizada em runtime.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
